
generator client {  
  provider = "prisma-client-js"  
}  
  

datasource db {  
  provider = "sqlite"  
} 
  
model User {  
  id            String    @id @default(cuid())  
  name          String?  
  email         String    @unique  
  password      String?  
  image         String?  
  createdAt     DateTime  @default(now())  
  updatedAt     DateTime  @updatedAt  
  projects      Project[]  
  subscriptions Subscription[]  
  budgetLimits  BudgetLimit[]  
  expenses      Expense[]  
  sessions      Session[]  
  accounts      Account[]  
} 
  
model Session {  
  id           String   @id @default(cuid())  
  sessionToken String   @unique  
  userId       String  
  expires      DateTime  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
}  
  
model Account {  
  id                String  @id @default(cuid())  
  userId            String  
  type              String  
  provider          String  
  providerAccountId String  
  refresh_token     String?  
  access_token      String?  
  expires_at        Int?  
  token_type        String?  
  scope             String?  
  id_token          String?  
  session_state     String?  
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)  
  @@unique([provider, providerAccountId])  
} 
  
model VerificationToken {  
  identifier String  
  token      String   @unique  
  expires    DateTime  
  @@unique([identifier, token])  
}  
  
model Project {  
  id          String   @id @default(cuid())  
  title       String  
  grossIncome Float  
  netIncome   Float?  
  taxRate     Float    @default(6.0)  
  status      String   @default("ACTIVE")  
  currency    String   @default("RUB")  
  userId      String  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
  createdAt   DateTime @default(now())  
  updatedAt   DateTime @updatedAt  
} 
  
model ExchangeRate {  
  id           String   @id @default(cuid())  
  baseCurrency String  
  targetCurrency String  
  rate         Float  
  source       String   @default("manual")  
  createdAt    DateTime @default(now())  
  updatedAt    DateTime @updatedAt  
  @@unique([baseCurrency, targetCurrency])  
}  
  
model Subscription {  
  id              String   @id @default(cuid())  
  title           String  
  amount          Float  
  intervalDays    Int  
  nextPaymentDate DateTime  
  currency        String   @default("RUB")  
  userId          String  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
  createdAt       DateTime @default(now())  
  updatedAt       DateTime @updatedAt  
} 
  
model BudgetLimit {  
  id          String   @id @default(cuid())  
  period      String  
  limitAmount Float  
  spentAmount Float    @default(0)  
  currency    String   @default("RUB")  
  month       Int?  
  year        Int?  
  userId      String  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
  expenses    Expense[]  
  createdAt   DateTime @default(now())  
  updatedAt   DateTime @updatedAt  
  @@unique([userId, period, month, year])  
}  
  
model Expense {  
  id           String   @id @default(cuid())  
  title        String  
  amount       Float  
  date         DateTime  
  category     String   @default("Other")  
  budgetLimitId String?  
  budgetLimit  BudgetLimit? @relation(fields: [budgetLimitId], references: [id], onDelete: Cascade)  
  userId       String  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)  
  createdAt    DateTime @default(now())  
  updatedAt    DateTime @updatedAt  
} 
